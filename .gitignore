mess/

# Testlaeufe, die aus dem falschen Arbeitsverzeichnis starten, legen ihren
# Spielstand unter ./data statt server/data/worlds ab — dieselbe Sorte
# Datei, dieselbe Regel: Spielstaende reisen nie (Konzept Editor/Live-Welt).
/data/
# Wegwerf-Verzeichnisse der Servertests (tmp-g6, tmp-verbindungsdeckel, …).
server/test/tmp-*/

# Bauergebnis von tools/vorschau-buendeln.mjs -- 2,7 MB, aus
# tools/web/vorschau-web.ts jederzeit neu erzeugbar.
tools/web/vorschau.js

# Die Webseite (wov-web/) ist ein eigenes npm-Projekt im selben Repo, aber
# BEWUSST KEIN Workspace: sonst zoege `npm ci` an der Wurzel SvelteKit und
# Vite auf jeden Container, auch auf den reinen Spielserver. Sie bringt
# deshalb ihre eigenen node_modules mit (die Regel ganz oben greift) und
# ihre eigenen Build-Ausgaben:
wov-web/build/
wov-web/.svelte-kit/

# Aufbereitete Store-Vegetation (tools/store-vegetation-aufbereiten.mjs).
# Erzeugt aus assets/store/vegetation/, in Sekunden neu gebaut, 53 MB —
# und der Store selbst liegt ohnehin ausserhalb des Repos. Der Ordnername
# sagt am Pfad, was die Datei ist: aus dem Store abgeleitet, nicht gepflegt.
assets/store-lab/
