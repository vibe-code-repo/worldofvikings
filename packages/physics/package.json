    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@babylonjs/core": "^8.31.1",
    "@babylonjs/havok": "^1.3.10"
  }
}
