{
  "name": "worldofvikings",
  "version": "0.1.0",
  "private": true,
  "description": "World of Vikings - Babylon.js-Client und autoritativer TypeScript-Spielserver",
  "workspaces": [
    "admin",
    "server",
    "client",
    "shared",
    "tools/asset-extractor",
    "tools/prefab-parser",
    "tools/worldlayout-mcp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "service:install": "sudo deploy/install-services.sh",
    "service:start": "sudo systemctl start wov.target",
    "service:stop": "sudo systemctl stop wov.target",
    "service:restart": "sudo systemctl restart wov-server wov-client",
    "service:status": "systemctl status wov-server wov-client --no-pager",
    "service:logs": "journalctl -fu wov-server -u wov-client",
    "build": "npm run build --workspaces --if-present",
    "extract:assets": "npm run extract --workspace=tools/asset-extractor",
    "parse:prefabs": "npm run parse --workspace=tools/prefab-parser",
    "store:aufbereiten": "tsx tools/store-vegetation-aufbereiten.mjs && tsx tools/store-prefabs.mjs",
    "store:quellen": "node tools/store-boden-quellen.mjs",
    "store:boden": "node tools/store-boden-quellen.mjs && node tools/store-terrain-schichten.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client && npm run typecheck --workspace=admin",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "playwright": "^1.61.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
