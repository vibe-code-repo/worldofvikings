[Unit]
# Betriebsdienst. Eigener Prozess, weil er wov-server neu starten koennen muss —
# als Teil des Spielservers wuerde er sich selbst abschiessen.
Description=World of Vikings — Betriebsdienst (Einstellungen, Dienste, Sicherungen)
Documentation=file:///opt/worldofvikings/admin/src/main.ts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/worldofvikings/admin
EnvironmentFile=/etc/wov.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Arbeitskopie der Welt: der Ordner steht AUSDRUECKLICH hier, nicht in einer Vorgabe des Codes. Ohne diese Zeile
# arbeitet der Dienst mit <Checkout>/server/data/welten-arbeit/ (von Git ignoriert) statt mit /var/lib/wov/welten.
# Die geaenderte Unit muss VOR oder MIT dem Rollout dieses Stands installiert werden
# (nach /etc/systemd/system kopieren, systemctl daemon-reload).
Environment=WOV_WELT_VERZEICHNIS=/var/lib/wov/welten
ExecStart=/opt/worldofvikings/node_modules/.bin/tsx src/main.ts
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wov-admin

[Install]
WantedBy=multi-user.target
