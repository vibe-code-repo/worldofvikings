{
  "name": "worldofvikings",
  "version": "0.1.0",
  "private": true,
  "description": "Valheim Babylon Port - Babylon.js client + 1:1 server port from Valhalla2.0 C++",
  "workspaces": [
    "admin",
    "server",
    "client",
    "shared",
    "tools/asset-extractor",
    "tools/prefab-parser",
    "tools/worldlayout-mcp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "service:install": "sudo deploy/install-services.sh",
    "service:start": "sudo systemctl start wov.target",
    "service:stop": "sudo systemctl stop wov.target",
    "service:restart": "sudo systemctl restart wov-server wov-client",
    "service:status": "systemctl status wov-server wov-client --no-pager",
    "service:logs": "journalctl -fu wov-server -u wov-client",
    "build": "npm run build --workspaces --if-present",
    "extract:assets": "npm run extract --workspace=tools/asset-extractor",
    "parse:prefabs": "npm run parse --workspace=tools/prefab-parser",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "cd shared && npx tsc --noEmit && cd ../server && npx tsc --noEmit && cd ../client && npx tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
