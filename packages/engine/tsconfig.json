{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The renderer package is the one place that talks to browser APIs
    // (canvas, window, navigator.gpu), so it needs the DOM lib.
    "lib": ["ES2022", "DOM"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../shared" }]
}
