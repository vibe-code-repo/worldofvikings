# services/api — local development defaults. No secret is required to run it.
API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# Authored game data the world and prefab routes read and write (ADR-0017).
# Default: the `content/` folder of this checkout, so a clean clone works.
# CONTENT_DIR=/srv/world-of-vikings/content

# Write protection. With this set, `PUT /worlds/:id` answers 403 and the
# service serves content read-only — what every deployment that carries
# official world data uses (spec §49). Unset locally, so the editor can save.
# WORLDS_READ_ONLY=1
