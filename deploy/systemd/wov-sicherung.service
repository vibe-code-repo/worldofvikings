[Unit]
# Dieselbe Unit auf dev und live, wie wov-server.service — die Instanz
# steckt in tools/wov-sicherung.sh nicht im Aufruf, sondern wird dort aus
# /etc/wov.env gelesen.
Description=World of Vikings — Sicherung von Spielstand und Weltdokumenten (Instanz aus /etc/wov.env)
Documentation=file:///opt/worldofvikings/tools/wov-sicherung.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/worldofvikings
EnvironmentFile=/etc/wov.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Arbeitskopie der Welt: der Ordner steht AUSDRUECKLICH hier, nicht in einer Vorgabe des Codes. Ohne diese Zeile
# arbeitet der Dienst mit <Checkout>/server/data/welten-arbeit/ (von Git ignoriert) statt mit /var/lib/wov/welten.
# Die geaenderte Unit muss VOR oder MIT dem Rollout dieses Stands installiert werden
# (nach /etc/systemd/system kopieren, systemctl daemon-reload).
Environment=WOV_WELT_VERZEICHNIS=/var/lib/wov/welten
ExecStart=/opt/worldofvikings/tools/wov-sicherung.sh
# Harte Obergrenze: ein Hänger (z. B. gesperrte Datenbank) würde sonst alle
# Folgeläufe des Timers blockieren. Das Skript hat je DB eine eigene Frist von 300 s.
TimeoutStartSec=1800
# Kein Restart=always: ein oneshot-Job, der scheitert, soll scheitern und
# im Log stehen — ein automatischer Neuversuch mitten in der Nacht würde
# nur denselben Fehler wiederholen (zu wenig Platz, kaputte Quelle) und den
# eigentlichen Befund verschleiern. Der Timer probiert es beim nächsten
# planmässigen Lauf ohnehin erneut.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wov-sicherung
