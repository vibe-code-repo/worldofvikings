node_modules/
dist/
# Zwischenstaende des atomaren Client-Tauschs in wov-update.sh. Der EXIT-Trap
# raeumt sie weg; der Eintrag hier ist der zweite Guertel.
client/dist.neu/
client/dist.alt/
out/
*.log
.DS_Store
.vs/
tools/out/
tools/assetripper/export/
tools/assetripper/temp/
tools/assetripper/*.exe
tools/assetripper/*.zip
tools/assetripper/*.dll
tools/asset-extractor/extract.js
tools/asset-extractor/extract.js.map
tools/asset-extractor/extract.d.ts
tools/asset-extractor/extract.d.ts.map
# F2 (Roadmap): assets/manifest.json ist Ergebnis UND Vertrag zugleich --
# tools/asset-manifest.mjs erzeugt es aus dem Plattenbestand, aber der
# Abgleich gegen shared/src/prefabs.ts (renderScale) und der
# Vollstaendigkeits-Test (tools/test/manifest-vollstaendig.ts) brauchen eine
# committete Fassung -- sonst gibt es nichts, wogegen sie pruefen koennten.
# Deshalb NICHT wie der Rest von assets/ ignoriert.
assets/*
!assets/manifest.json
server/data/worlds/
# G12: Betriebsmetriken-Schnappschuss, einmal je Sekunde vom laufenden
# Spielserver ueberschrieben -- Laufzeitzustand wie die Spielstaende oben,
# gehoert nicht ins Repo.
server/data/metriken.json
# Rohmaterial: Unity-AssetBundles (Willybach HD u. a.)
screenshots/newtexture/
*.bundle
# Screenshots, Referenzbilder und Rohmodelle (1,4 GB): Arbeitsmaterial,
# kein Quellcode. Die Vergleichsbilder, auf die sich
# Docs/07-Grafik-Konzept.md beruft, liegen hier — Zahlen und Herkunft
# stehen aber im Dokument, damit die Argumentation ohne die Dateien
# nachvollziehbar bleibt.
screenshots/
# S7 (2026-08-20, Begruendung siehe Konzept Dungeons und Instanzen, Ebene 3+6):
# server/data/dungeons/<welt>/*.json ist DungeonDocument mit Feld "mode".
# "custom" = von Hand im F4-Editor gebaut, nicht reproduzierbar -- Autorenarbeit,
# muss ins Repo. Aktuell einziges Beispiel: dev/forestcrypt-1092.json, 34 Raeume,
# 11 Tueren, entstanden 02.08. -- existiert sonst auf genau einer Platte.
# "generated" = aus base+seed jederzeit neu erzeugbar (DungeonManager.ts
# Kopfkommentar), entsteht als Nebenprodukt von Admin-Testbefehlen
# ("dungeon create"/"dungeon regen") oder beim ersten Betreten -- Massenware,
# bleibt ignoriert. Ebenso entrances.json: reine Laufzeit-Zuordnung, faul befuellt,
# eine frische Welt bucht ueber 1000 Eingaenge -- Ausnahme unten betrifft sie nicht.
server/data/dungeons/*
!server/data/dungeons/dev/
server/data/dungeons/dev/*
!server/data/dungeons/dev/forestcrypt-1092.json

# Review-Punkt 30: Build-Artefakte, Rip-Werkzeug, Sicherungen
tsc-log.txt
*.bak
__pycache__/
*.pyc
server/data/worlds/*.orphan-*
server/data/*.locations.json
mess/

# Claude-Code-Einstellungen des Containers (lokal, nicht geteilt)
.claude/
# Messungen und weggelegte Zwischenstaende
mess/

# Testlaeufe, die aus dem falschen Arbeitsverzeichnis starten, legen ihren
# Spielstand unter ./data statt server/data/worlds ab — dieselbe Sorte
# Datei, dieselbe Regel: Spielstaende reisen nie (Konzept Editor/Live-Welt).
/data/
# Wegwerf-Verzeichnisse der Servertests (tmp-g6, tmp-verbindungsdeckel, …).
server/test/tmp-*/

# Bauergebnis von tools/vorschau-buendeln.mjs -- 2,7 MB, aus
# tools/web/vorschau-web.ts jederzeit neu erzeugbar.
tools/web/vorschau.js

# Die Webseite (wov-web/) ist ein eigenes npm-Projekt im selben Repo, aber
# BEWUSST KEIN Workspace: sonst zoege `npm ci` an der Wurzel SvelteKit und
# Vite auf jeden Container, auch auf den reinen Spielserver. Sie bringt
# deshalb ihre eigenen node_modules mit (die Regel ganz oben greift) und
# ihre eigenen Build-Ausgaben:
wov-web/build/
wov-web/.svelte-kit/
