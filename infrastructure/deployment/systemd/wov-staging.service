[Unit]
Description=World of Vikings 2026 staging (WOV_STAGING_MODE=build serves the built bundles)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/worldofvikings
Environment=HOME=/root
EnvironmentFile=/etc/wov-staging.env
ExecStart=/opt/worldofvikings/infrastructure/deployment/staging.sh
Restart=on-failure
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
