[Unit]
Description=Valheim Babylon — Game-Server (WebSocket, Port 2466)
Documentation=file://__PROJECT_DIR__/Docs/05-Server-Architektur.md
PartOf=valheim.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=NODE_ENV=development
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# dev = tsx watch: startet bei Codeänderungen automatisch neu
ExecStart=/usr/bin/npm run dev:server
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=valheim-server

[Install]
WantedBy=valheim.target
