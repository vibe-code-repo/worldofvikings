{
  "name": "world-of-vikings",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source browser RPG and world editor (monorepo root).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "pnpm run build:packages",
    "build:packages": "tsc -b tsconfig.packages.json",
    "dev:packages": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput",
    "dev": "concurrently -k -n packages,website,game,editor,api,assets -c gray,magenta,cyan,yellow,green,blue \"pnpm run dev:packages\" \"pnpm --filter @wov/website dev\" \"pnpm --filter @wov/game dev\" \"pnpm --filter @wov/editor dev\" \"pnpm --filter @wov/api dev\" \"pnpm run dev:assets\"",
    "dev:assets": "tsx tooling/scripts/asset-server.ts",
    "build": "pnpm run build:packages && pnpm --filter \"./apps/*\" --filter \"./services/*\" build",
    "typecheck": "pnpm run build:packages && pnpm --filter \"./apps/*\" --filter \"./services/*\" --parallel typecheck && tsc -p tsconfig.test.json",
    "lint": "eslint . && pnpm run lint:boundaries",
    "lint:boundaries": "depcruise apps packages services tooling --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate": "pnpm run validate:content && pnpm run validate:assets",
    "validate:content": "tsx tooling/validators/validate-content.ts",
    "validate:assets": "tsx tooling/validators/validate-assets.ts",
    "import:world-assets": "tsx tooling/asset-pipeline/import-world-assets.ts",
    "import:scene": "tsx tooling/scripts/import-scene.ts",
    "import:scene-models": "tsx tooling/scripts/import-scene-models.ts",
    "import:backdrop": "tsx tooling/scripts/import-backdrop.ts",
    "import:audio": "tsx tooling/asset-pipeline/import-audio.ts",
    "scatter": "tsx tooling/scripts/scatter.ts",
    "seating": "tsx tooling/scripts/seating.ts",
    "terrain-surface": "tsx tooling/scripts/terrain-surface.ts",
    "generate:prefabs": "tsx tooling/scripts/generate-prefabs.ts",
    "perf:frame": "tsx tooling/perf/frame-profile.ts",
    "perf:compare": "tsx tooling/perf/compare-frames.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run validate",
    "smoke": "playwright test --config tooling/smoke/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.8",
    "@wov/asset-system": "workspace:*",
    "@wov/content-build": "workspace:*",
    "@wov/editor-core": "workspace:*",
    "@wov/world-schema": "workspace:*",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.0.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
