{
  // Type-checks the test files, which the emitting package configs exclude.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "services/*/src/**/*.test.ts",
    "tooling/**/*.ts",
    "vitest.config.ts"
  ]
}
