[Unit]
Description=World of Vikings — Betriebsdienst (Einstellungen, Dienste, Sicherungen)
Documentation=file:///opt/worldofvikings/admin/src/main.ts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/worldofvikings
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Lauscht NUR auf der internen Bruecke — siehe Kopfkommentar von main.ts.
Environment=WOV_ADMIN_ADRESSE=10.10.10.11
Environment=WOV_ADMIN_PORT=2468
Environment=WOV_INSTANZ=live
ExecStart=/usr/bin/npx tsx admin/src/main.ts
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wov-admin

[Install]
WantedBy=multi-user.target
