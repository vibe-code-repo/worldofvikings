{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // `test-support.ts` is fixtures for the tests in this package, not shipped
  // code, so it stays out of the build the same way the tests do.
  "exclude": ["src/**/*.test.ts", "src/test-support.ts"],
  "references": [{ "path": "../world-schema" }]
}
